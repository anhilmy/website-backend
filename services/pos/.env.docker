# Docker Environment Variables for Docker Compose
# This file contains Docker-specific configurations

# Database Configuration (for Docker containers)
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://postgres:5432/website_backend
DB_USERNAME=backenduser
DB_PASSWORD=password
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Development flag for Docker
DEVELOPMENT=false

# Docker-specific database settings
POSTGRES_DB=website_backend
POSTGRES_USER=backenduser
POSTGRES_PASSWORD=password