# Docker Environment Variables for Docker Compose
# Used by: docker-compose --env-file .env.docker up

# ---- Profile ----
PROFILE=docker

# ---- Database (host: postgres service in compose) ----
DB_TYPE=postgresql
DB_URL=jdbc:postgresql://postgres:5432/website_backend
DB_USERNAME=backenduser
DB_PASSWORD=password

# ---- Server ----
SERVER_PORT=4567

# ---- JWT ----
# REQUIRED: no default is shipped. Generate one, e.g. `openssl rand -hex 32`, and export it:
#   export JWT_SECRET=<your value>
# (docker compose will refuse to start without it.)
# JWT_SECRET=
JWT_EXPIRATION=3600

# ---- Postgres container bootstrap ----
POSTGRES_DB=website_backend
POSTGRES_USER=backenduser
POSTGRES_PASSWORD=password
