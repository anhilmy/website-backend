# POS System Environment Variables
# Copy this file to .env and modify as needed.
#
# Resolution order at runtime is: environment variable > application-<PROFILE>.properties > application.properties.
# Set PROFILE to one of: dev (default), docker, prod.

# ---- Profile ----
PROFILE=dev

# ---- Database ----
# dev (SQLite): leave DB_TYPE=sqlite and DB_URL pointing at a local file
DB_TYPE=sqlite
DB_URL=jdbc:sqlite:pos_dev.db

# prod / docker (PostgreSQL) - uncomment and set
# DB_TYPE=postgresql
# DB_URL=jdbc:postgresql://localhost:5432/website_backend
# DB_USERNAME=backenduser
# DB_PASSWORD=password

# ---- Server ----
SERVER_PORT=4567

# ---- JWT (MUST be a long random value in production) ----
JWT_SECRET=change_me_in_production_please_use_a_long_random_secret_value
JWT_EXPIRATION=3600

# ---- Business rules ----
ORDER_TAX_RATE=0.10

# ---- Seed demo data (dev only) ----
SEED_ENABLED=true
